# 실제 값은 .env 파일에 넣으세요 (.gitignore에 이미 등록되어 git에 올라가지 않음)
# data.go.kr에서 발급받은 서비스키는 "디코딩(Decoding)" 키를 사용하세요.
# WebClient가 쿼리파라미터를 자동 URL-인코딩하므로, 인코딩된 키를 넣으면 이중 인코딩되어
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 발생합니다.

# data.go.kr 통합 서비스키 - 한국관광공사(KorService2/TarRlteTarService1/TatsCnctrRateService/DataLabService)
# 및 기상청 단기예보(VilageFcstInfoService_2.0)까지 동일한 키 하나로 공용 사용
TOURAPI_KEY=

# OpenAI API 키 (Stage4 태그매칭/문장생성, 도슨트 스크립트 생성)
OPENAI_API_KEY=
# 사용할 모델 (기본값: gpt-4o-mini)
OPENAI_MODEL=

# H2 콘솔 접근 허용 여부 (로컬 개발 시에만 true 권장)
H2_CONSOLE_ENABLED=false
