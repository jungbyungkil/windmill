# 실제 값은 .env 파일에 넣으세요 (.gitignore에 이미 등록되어 git에 올라가지 않음)
# data.go.kr에서 발급받은 서비스키는 "디코딩(Decoding)" 키를 사용하세요.
# WebClient가 쿼리파라미터를 자동 URL-인코딩하므로, 인코딩된 키를 넣으면 이중 인코딩되어
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 발생합니다.

# ---------------------------------------------------------------------------
# [필수] data.go.kr 통합 서비스키 (TOURAPI_KEY)
# 아래 API를 같은 키로 활용신청(승인)해야 핵심 기능이 동작합니다.
#
# 1) 한국관광공사 KorService2
#    - 장소 목록/상세, 스마트 일정 후보
# 2) TarRlteTarService1 (연관관광지)
#    - 추천 파이프라인 Stage1
# 3) TatsCnctrRateService (관광지 집중률)
#    - 혼잡도↓ 필터, 바람개비 혼잡 트리거
# 4) DataLabService (선택)
#    - 지역 방문자수 참고
# 5) 기상청 VilageFcstInfoService_2.0 (단기예보 ~3일)
#    - 비(POP)·기온(TMP/TMX) → 바람개비 빨강 + 실내 대체 일정
# 6) 기상청 MidFcstInfoService (중기예보 ~3~10일)
#    - 육상/기온 전망 → 여행 며칠 앞 참고용 배너
#    ※ 관광공사 키와 동일 키 재사용. 기상청 서비스도 활용신청 필요.
#
# 지역 격자좌표(weatherNx/Ny)는 backend region-codes.json에 포함되어 있어야
# 해당 지역의 날씨/폭염 감지가 됩니다.
# ---------------------------------------------------------------------------
TOURAPI_KEY=

# ---------------------------------------------------------------------------
# [선택] OpenAI API 키
# - Stage4 태그/한줄소개, AI 도슨트, AI 초안 일정
# - 없어도 TourAPI 기반 스마트 일정·혼잡·날씨 대응은 동작합니다.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# H2 콘솔 접근 허용 여부 (로컬 개발 시에만 true 권장)
H2_CONSOLE_ENABLED=false

# ---------------------------------------------------------------------------
# [선택] 카카오맵 · 길찾기
# - KAKAO_REST_API_KEY: 서버 전용 (길찾기 프록시). 프론트에 넣지 마세요.
# - 프론트 JS 키는 frontend/.env 의 VITE_KAKAO_JS_KEY (도메인 제한 필수)
#   https://developers.kakao.com → 앱 → 플랫폼 → Web 도메인 등록
#   (예: http://localhost:5173 , https://your-app.onrender.com)
# ---------------------------------------------------------------------------
KAKAO_REST_API_KEY=
