# Vite 프론트 환경변수 예시 — 이 파일을 복사해 .env 로 사용하세요.
# JS 키는 브라우저에 노출되므로 카카오 콘솔에서 Web 도메인 제한을 꼭 설정하세요.
# http://localhost:5173 및 Render 배포 도메인 등록.

VITE_KAKAO_JS_KEY=

# 백엔드를 Vite 프록시(/api)가 아닌 다른 주소로 둘 때만
# VITE_API_URL=http://localhost:8080/api

# 웹 푸시(FCM) - 보통은 백엔드 FIREBASE_WEB_* 를 /api/public-config로 읽으므로 프론트에 안 넣어도 됩니다.
# 백엔드 없이 토큰 발급만 시험할 때만 사용하세요.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
